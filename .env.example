# Configuration Sen-E-Carte SaaS (copier en .env.local et remplir vos clés)
NEXT_PUBLIC_SITE_URL=https://www.senecarte.com
NEXT_PUBLIC_SUPER_ADMIN_PIN=2026

# Alertes & rapports automatiques (Prospection, Veille & Marketing)
PROSPECTION_ALERT_EMAIL=ahmedtall08@gmail.com
RESEND_API_KEY=re_votre_cle_resend
RESEND_FROM_EMAIL=Sen-E-Carte <onboarding@resend.dev>

# Recherche internet temps réel (Chatbot IA, Veille Agent-Reach & Prospection)
BRAVE_SEARCH_API_KEY=BSA_votre_cle_brave

# Passerelle LLM Multi-Modèles (APInex OpenAI-compatible ou Groq/Gemini)
LLM_BASE_URL=https://api.apinex.bond/v1
LLM_API_KEY=sk-apx_votre_cle_llm
LLM_MODEL=free/deepseek-v4.1-flash

# Base de données gratuite >= 10 Go (ex: TiDB Cloud 25 Go gratuit ou PostgreSQL)
DATABASE_URL=mysql://user:password@gateway01.eu-central-1.prod.aws.tidbcloud.com:4000/senecarte?ssl={"rejectUnauthorized":true}

# Sécurisation des tâches planifiées Vercel Cron (optionnel)
CRON_SECRET=votre_secret_cron_aleatoire
